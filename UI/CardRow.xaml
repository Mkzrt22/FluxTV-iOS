<UserControl
    x:Class="FluxTV.UI.CardRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluxTV.UI"
    IsTabStop="False">

    <!-- Rangée de l'accueil ou de la recherche : titre puis cartes qui défilent à l'horizontale -->
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <TextBlock x:Name="Header" Style="{StaticResource SectionText}" />
            <TextBlock x:Name="CountText" Style="{StaticResource FaintText}" VerticalAlignment="Bottom" Margin="10,0,0,2" />
        </StackPanel>
        <ListView x:Name="Cards"
                  Style="{StaticResource RowListStyle}"
                  ItemContainerStyle="{StaticResource CardItemStyle}"
                  Margin="-14,0,0,0"
                  Padding="14,12,48,14"
                  ui:TvScroll.Margins="24,62,72,24"
                  ItemClick="OnItemClick"
                  KeyDown="OnKeyDown"
                  ContainerContentChanging="OnContainerChanging" />
    </StackPanel>
</UserControl>
