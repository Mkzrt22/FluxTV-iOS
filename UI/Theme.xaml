<ResourceDictionary
    x:Class="FluxTV.UI.Theme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluxTV.UI">

    <!-- Charte FluxTV : nuit profonde, indigo et violet, Sora (titres) et Manrope (texte).
         La Xbox affiche l'interface en 960 × 540 pixels effectifs ; marges de sécurité de la télé : 48 × 27. -->

    <!-- ───────────────────────────── Couleurs ───────────────────────────── -->
    <Color x:Key="SystemAccentColor">#5B5CF0</Color>
    <Color x:Key="SystemAccentColorLight1">#7476F3</Color>
    <Color x:Key="SystemAccentColorLight2">#8E97FF</Color>
    <Color x:Key="SystemAccentColorLight3">#B4BAFF</Color>
    <Color x:Key="SystemAccentColorDark1">#4A4BD6</Color>
    <Color x:Key="SystemAccentColorDark2">#3B3CB8</Color>
    <Color x:Key="SystemAccentColorDark3">#2D2E99</Color>

    <SolidColorBrush x:Key="AbyssBrush" Color="#04040D" />
    <SolidColorBrush x:Key="BgBrush" Color="#080818" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#10102A" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#181838" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#23235A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B5CF0" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#8E97FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E5B5CF0" />
    <SolidColorBrush x:Key="VioletBrush" Color="#9B4DEB" />
    <SolidColorBrush x:Key="OnAirBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="OkBrush" Color="#34D399" />
    <SolidColorBrush x:Key="GoldBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="GoldSoftBrush" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2FF" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#A6ABD2" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#7D83B3" />
    <SolidColorBrush x:Key="GlassBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5B5CF0" Offset="0" />
        <GradientStop Color="#9B4DEB" Offset="1" />
    </LinearGradientBrush>
    <!-- Voiles sur les images (texte lisible par-dessus) -->
    <LinearGradientBrush x:Key="ShadeBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00080818" Offset="0" />
        <GradientStop Color="#E6080818" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShadeLeft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F2080818" Offset="0" />
        <GradientStop Color="#B3080818" Offset="0.45" />
        <GradientStop Color="#00080818" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShadeTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC04040D" Offset="0" />
        <GradientStop Color="#0004040D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShadeBottomStrong" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0004040D" Offset="0" />
        <GradientStop Color="#9904040D" Offset="0.4" />
        <GradientStop Color="#F204040D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RailShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F504040D" Offset="0" />
        <GradientStop Color="#E604040D" Offset="0.55" />
        <GradientStop Color="#0004040D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelShade" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="#FA06061A" Offset="0" />
        <GradientStop Color="#F206061A" Offset="0.8" />
        <GradientStop Color="#0006061A" Offset="1" />
    </LinearGradientBrush>

    <!-- Champs de texte et interrupteurs aux couleurs de l'app -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#F1F2FF" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F1F2FF" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8E97FF" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7D83B3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#7D83B3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A6ABD2" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#F1F2FF" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#5B5CF0" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#5B5CF0" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7476F3" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4A4BD6" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#A6ABD2" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A6ABD2" />
    <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="#F1F2FF" />
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#A6ABD2" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#8E97FF" />

    <!-- ───────────────────────────── Polices ───────────────────────────── -->
    <FontFamily x:Key="FontRegular">ms-appx:///Assets/Fonts/Manrope-Regular.ttf#Manrope</FontFamily>
    <FontFamily x:Key="FontMedium">ms-appx:///Assets/Fonts/Manrope-Medium.ttf#Manrope</FontFamily>
    <FontFamily x:Key="FontSemi">ms-appx:///Assets/Fonts/Manrope-SemiBold.ttf#Manrope</FontFamily>
    <FontFamily x:Key="FontBold">ms-appx:///Assets/Fonts/Manrope-Bold.ttf#Manrope</FontFamily>
    <FontFamily x:Key="FontTitle">ms-appx:///Assets/Fonts/Sora-SemiBold.ttf#Sora</FontFamily>
    <FontFamily x:Key="FontDisplay">ms-appx:///Assets/Fonts/Sora-Bold.ttf#Sora</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe MDL2 Assets</FontFamily>

    <!-- ───────────────────────────── Textes ───────────────────────────── -->
    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextLineBounds" Value="Full" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>
    <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontRegular}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style x:Key="FaintText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="StrongText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="CardSubText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Barre d'avancement fine (programme en cours, reprise) -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource TrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- ───────────────────────────── Boutons ───────────────────────────── -->
    <!-- Focus manette : le bouton grandit et s'entoure de blanc. -->
    <Style x:Key="FluxButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Height" Value="42" />
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FocusScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Inner" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.18">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="Inner" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" />
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border x:Name="Ring" BorderBrush="{StaticResource WhiteBrush}" BorderThickness="2"
                                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton principal : dégradé indigo → violet -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FluxButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    </Style>

    <!-- Bouton rond à icône (favori, pistes…) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FluxButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Petite pastille (catégories, saisons, options) -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource FluxButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
    </Style>

    <!-- Grande carte cliquable (mise en avant de l'accueil) : agrandissement discret -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FocusScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Ring" Margin="-5" BorderBrush="{StaticResource WhiteBrush}" BorderThickness="3"
                                CornerRadius="22" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu latéral : icône seule, libellé quand le menu est ouvert -->
    <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AbyssBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Bg" Background="{StaticResource WhiteBrush}" CornerRadius="22" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────────────────────────── Listes ───────────────────────────── -->
    <!-- Rangée horizontale de cartes (accueil, recherche, épisodes) -->
    <Style x:Key="RowListStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ShowsScrollingPlaceholders" Value="False" />
        <Setter Property="IsSwipeEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.IsHorizontalRailEnabled" Value="False" />
        <Setter Property="ScrollViewer.ZoomMode" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liste verticale (catégories, chaînes, panneaux du lecteur) -->
    <Style x:Key="ColumnListStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ShowsScrollingPlaceholders" Value="False" />
        <Setter Property="IsSwipeEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="False" />
    </Style>

    <!-- Grille de catalogue (films, séries) -->
    <Style x:Key="CatalogGridStyle" TargetType="GridView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ShowsScrollingPlaceholders" Value="False" />
        <Setter Property="IsSwipeEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="False" />
    </Style>

    <!-- Carte dans une rangée ou une grille : agrandie et cerclée de blanc sous le focus -->
    <Style x:Key="CardItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="IsHoldingEnabled" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FocusScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.18">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Ring" Margin="-6" CornerRadius="14" Background="{StaticResource GlassBrush}"
                                BorderBrush="{StaticResource WhiteBrush}" BorderThickness="2" Opacity="0" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardGridItemStyle" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,14,16" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="IsHoldingEnabled" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FocusScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.18">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Ring" Margin="-6" CornerRadius="14" Background="{StaticResource GlassBrush}"
                                BorderBrush="{StaticResource WhiteBrush}" BorderThickness="2" Opacity="0" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ligne d'une liste verticale : fond de verre et liseré blanc sous le focus -->
    <Style x:Key="RowItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="IsHoldingEnabled" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FocusScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.14" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="FocusScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Ring" CornerRadius="10" Background="{StaticResource GlassStrongBrush}"
                                BorderBrush="{StaticResource WhiteBrush}" BorderThickness="2" Opacity="0" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pastille dans une rangée horizontale (saisons) -->
    <Style x:Key="ChipItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource RowItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource WhiteBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FocusVisualMargin" Value="-8,-6" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,9,8,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource WhiteBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>

    <Style x:Key="FieldPassword" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,9,8,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource WhiteBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    </Style>

    <!-- ───────────────────────────── Modèles des cartes ───────────────────────────── -->

    <!-- Affiche de film ou de série (2:3) -->
    <DataTemplate x:Key="PosterTemplate" x:DataType="ui:CardItem">
        <StackPanel Width="104">
            <Grid Height="156">
                <ui:RemoteImage Url="{x:Bind Image}" ImageStretch="UniformToFill" DecodeWidth="104" Radius="10" Glyph="&#xE8B2;" />
                <Border Height="56" VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Background="{StaticResource ShadeBottom}"
                        Visibility="{x:Bind HasProgress, Mode=OneWay}" />
                <ProgressBar Style="{StaticResource ThinProgress}" Value="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Bottom"
                             Margin="8,0,8,8" Visibility="{x:Bind HasProgress, Mode=OneWay}" />
                <Border Visibility="{x:Bind Watched, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                        Width="22" Height="22" CornerRadius="11" Background="{StaticResource OkBrush}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AbyssBrush}" />
                </Border>
                <Border Visibility="{x:Bind HasBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                        Padding="5,2" CornerRadius="5" Background="#CC04040D" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <TextBlock Text="{x:Bind Badge}" Style="{StaticResource FaintText}" FontSize="9" Foreground="{StaticResource TextBrush}" CharacterSpacing="60" />
                </Border>
            </Grid>
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}" Margin="2,8,2,0" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CardSubText}" Margin="2,1,2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Carte large 16:9 (reprises, épisodes de l'accueil) -->
    <DataTemplate x:Key="WideTemplate" x:DataType="ui:CardItem">
        <StackPanel Width="192">
            <Grid Height="108">
                <Border CornerRadius="10" Background="{StaticResource Surface2Brush}" Visibility="{x:Bind IsLogo}" />
                <ui:RemoteImage Url="{x:Bind Image}" ImageStretch="{x:Bind ImageStretch}" ImagePadding="{x:Bind ImagePadding}"
                                DecodeWidth="192" Radius="10" Glyph="&#xE714;" />
                <Border Height="54" VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Background="{StaticResource ShadeBottom}"
                        Visibility="{x:Bind HasProgress, Mode=OneWay}" />
                <ProgressBar Style="{StaticResource ThinProgress}" Value="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Bottom"
                             Foreground="{x:Bind ProgressBrush}" Margin="10,0,10,9" Visibility="{x:Bind HasProgress, Mode=OneWay}" />
                <Border Visibility="{x:Bind HasNumber}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7"
                        Padding="6,1" CornerRadius="6" Background="#CC04040D">
                    <TextBlock Text="{x:Bind Number}" Style="{StaticResource FaintText}" Foreground="{StaticResource TextBrush}" />
                </Border>
            </Grid>
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}" Margin="2,8,2,0" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CardSubText}" Margin="2,1,2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Catégorie ou saison (liste verticale) -->
    <DataTemplate x:Key="CategoryTemplate" x:DataType="ui:CategoryItem">
        <Grid Height="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="18" CornerRadius="2" Background="{StaticResource AccentBrightBrush}" Margin="0,0,9,0"
                    Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                       Foreground="{x:Bind NameBrush, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{x:Bind Count, Mode=OneWay}" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
    </DataTemplate>

    <!-- Chaîne dans la liste du direct -->
    <DataTemplate x:Key="ChannelRowTemplate" x:DataType="ui:ChannelItem">
        <Grid Height="54">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Number}" Style="{StaticResource FaintText}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Width="56" Height="36" HorizontalAlignment="Left">
                <Border CornerRadius="7" Background="{StaticResource GlassBrush}" />
                <ui:RemoteImage Url="{x:Bind Logo}" ImageStretch="Uniform" DecodeWidth="56" Radius="0" Margin="5,4" Glyph="&#xE7F4;" />
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource LabelText}" />
                <TextBlock Text="{x:Bind NowTitle, Mode=OneWay}" Style="{StaticResource CardSubText}" Margin="0,1,0,0"
                           Visibility="{x:Bind HasNow, Mode=OneWay}" />
                <ProgressBar Style="{StaticResource ThinProgress}" Height="3" MinHeight="3" Value="{x:Bind Progress, Mode=OneWay}"
                             Foreground="{StaticResource OnAirBrush}" Margin="0,4,0,0" Width="120" HorizontalAlignment="Left"
                             Visibility="{x:Bind HasNow, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="&#xE735;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource GoldBrush}"
                       Visibility="{x:Bind IsFavorite, Mode=OneWay}" Margin="0,0,2,0" />
        </Grid>
    </DataTemplate>

    <!-- Épisode (rangée horizontale de la fiche série) -->
    <DataTemplate x:Key="EpisodeTemplate" x:DataType="ui:EpisodeItem">
        <StackPanel Width="200">
            <Grid Height="112">
                <ui:RemoteImage Url="{x:Bind Image}" ImageStretch="UniformToFill" DecodeWidth="200" Radius="10" Glyph="&#xE714;" />
                <Border Height="54" VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Background="{StaticResource ShadeBottom}" />
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource FaintText}" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Bottom" Margin="10,0,0,16" />
                <TextBlock Text="{x:Bind Duration}" Style="{StaticResource FaintText}" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="0,0,10,16" />
                <ProgressBar Style="{StaticResource ThinProgress}" Value="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Bottom"
                             Margin="10,0,10,7" Visibility="{x:Bind HasProgress, Mode=OneWay}" />
                <Border Visibility="{x:Bind Watched, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"
                        Width="22" Height="22" CornerRadius="11" Background="{StaticResource OkBrush}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AbyssBrush}" />
                </Border>
            </Grid>
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}" Margin="2,8,2,0" />
            <TextBlock Text="{x:Bind Plot}" Style="{StaticResource CardSubText}" Margin="2,1,2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Pastille de saison -->
    <DataTemplate x:Key="SeasonTemplate" x:DataType="ui:CategoryItem">
        <Border Height="34" Padding="16,0" CornerRadius="17" Background="{x:Bind ChipBrush, Mode=OneWay}">
            <TextBlock Text="{x:Bind Name}" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                       Foreground="{x:Bind NameBrush, Mode=OneWay}" />
        </Border>
    </DataTemplate>

    <!-- Option d'un panneau du lecteur (piste audio, sous-titres) -->
    <DataTemplate x:Key="OptionTemplate" x:DataType="ui:OptionItem">
        <Grid Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource AccentBrightBrush}"
                       HorizontalAlignment="Left" Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource LabelText}" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CardSubText}" Visibility="{x:Bind HasDetail}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
