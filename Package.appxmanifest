<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- L'éditeur doit être identique au sujet du certificat de signature (Signature\FluxTV-test.cer) -->
  <Identity Name="FluxTV" Publisher="CN=FluxTV" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="6f1c2d3e-8a9b-4c5d-9e7f-1a2b3c4d5e6f" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>FluxTV</DisplayName>
    <PublisherDisplayName>Kevin G</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="FluxTV.App">
      <uap:VisualElements
        DisplayName="FluxTV"
        Description="Lecteur IPTV : TV en direct, guide des programmes, films et séries."
        BackgroundColor="#080818"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" ShortName="FluxTV" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0C0C22" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Serveurs et playlists sur le réseau local -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
