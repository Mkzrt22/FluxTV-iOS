<local:TvPage
    x:Class="FluxTV.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxTV.Views"
    xmlns:ui="using:FluxTV.UI"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" IsVerticalRailEnabled="False" ZoomMode="Disabled" IsTabStop="False">
        <StackPanel Padding="0,27,0,40">
            <!-- En-tête : salutation, abonnement, heure -->
            <Grid Height="34" Margin="0,0,48,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Greeting" Style="{StaticResource TitleText}" FontSize="20" />
                    <TextBlock x:Name="SourceName" Style="{StaticResource DimText}" Margin="12,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SubscriptionChip" Visibility="Collapsed" CornerRadius="13" Padding="12,4" Margin="0,0,14,0"
                            Background="{StaticResource GlassBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="SubscriptionText" Style="{StaticResource LabelText}" FontSize="12" />
                    </Border>
                    <TextBlock x:Name="Clock" Style="{StaticResource TitleText}" FontSize="20" />
                </StackPanel>
            </Grid>

            <!-- Mise en avant : reprise, chaîne favorite ou film à découvrir -->
            <Button x:Name="Hero" Style="{StaticResource CardButton}" Height="212" Margin="0,16,48,4" Click="OnHeroClick"
                    GotFocus="OnHeroFocus" Visibility="Collapsed">
                <Grid>
                    <Border CornerRadius="18" Background="{StaticResource Surface2Brush}" />
                    <ui:RemoteImage x:Name="HeroImage" Radius="18" DecodeWidth="800" Glyph="&#xE714;" />
                    <Border CornerRadius="18" Background="{StaticResource ShadeLeft}" />
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="28,0,28,24" MaxWidth="470">
                        <TextBlock x:Name="HeroEyebrow" Style="{StaticResource EyebrowText}" />
                        <TextBlock x:Name="HeroTitle" Style="{StaticResource DisplayText}" FontSize="30" LineHeight="36" Margin="0,6,0,0" />
                        <TextBlock x:Name="HeroSubtitle" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                        <ProgressBar x:Name="HeroProgress" Style="{StaticResource ThinProgress}" Width="240" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        <Border Background="{StaticResource AccentGradient}" CornerRadius="17" Height="34" Padding="16,0" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource WhiteBrush}" />
                                <TextBlock x:Name="HeroAction" Style="{StaticResource StrongText}" FontSize="14" Foreground="{StaticResource WhiteBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Button>

            <ui:CardRow x:Name="ResumeRow" Title="Continuer à regarder" CardTemplate="{StaticResource WideTemplate}" />
            <ui:CardRow x:Name="FavChannelsRow" Title="Mes chaînes" CardTemplate="{StaticResource WideTemplate}" />
            <ui:CardRow x:Name="RecentChannelsRow" Title="Dernières chaînes" CardTemplate="{StaticResource WideTemplate}" />
            <ui:CardRow x:Name="DiscoverRow" Title="Chaînes en direct" CardTemplate="{StaticResource WideTemplate}" />
            <ui:CardRow x:Name="MoviesRow" Title="Films" CardTemplate="{StaticResource PosterTemplate}" />
            <ui:CardRow x:Name="SeriesRow" Title="Séries" CardTemplate="{StaticResource PosterTemplate}" />
            <ui:CardRow x:Name="FavMoviesRow" Title="Films favoris" CardTemplate="{StaticResource PosterTemplate}" />
            <ui:CardRow x:Name="FavSeriesRow" Title="Séries favorites" CardTemplate="{StaticResource PosterTemplate}" />

            <!-- Chargement ou erreur des chaînes -->
            <StackPanel x:Name="LiveState" Visibility="Collapsed" Margin="0,40,48,0" HorizontalAlignment="Center" MaxWidth="460">
                <ProgressRing x:Name="LiveRing" Width="36" Height="36" IsActive="False" Foreground="{StaticResource AccentBrightBrush}" />
                <TextBlock x:Name="LiveStateTitle" Style="{StaticResource TitleText}" FontSize="18" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="LiveStateText" Style="{StaticResource BodyText}" TextAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,6,0,0" MaxLines="4" />
                <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Click="OnRetry" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource WhiteBrush}" />
                        <TextBlock Text="Réessayer" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:TvPage>
