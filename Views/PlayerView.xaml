<UserControl
    x:Class="FluxTV.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluxTV.UI"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <Storyboard x:Name="ControlsIn">
            <DoubleAnimation Storyboard.TargetName="Controls" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
        </Storyboard>
        <Storyboard x:Name="ControlsOut">
            <DoubleAnimation Storyboard.TargetName="Controls" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
        </Storyboard>
        <Storyboard x:Name="FlashAnim">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource FluxButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="Margin" Value="12,14,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Black">
        <!-- Visuel du contenu pendant l'ouverture -->
        <ui:RemoteImage x:Name="LoadingArt" ImageStretch="UniformToFill" DecodeWidth="960" Glyph="" Opacity="0.22" />

        <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" Stretch="Uniform" />

        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <ProgressRing x:Name="BufferRing" Width="52" Height="52" Foreground="{StaticResource WhiteBrush}" IsActive="True" />
            <TextBlock x:Name="LoadingText" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>

        <!-- Commandes et informations -->
        <Grid x:Name="Controls" Visibility="Collapsed" Opacity="0">
            <!-- Voiles : titre et commandes lisibles même sur une image claire -->
            <Rectangle VerticalAlignment="Top" Height="180" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E604040D" Offset="0" />
                        <GradientStop Color="#8C04040D" Offset="0.55" />
                        <GradientStop Color="#0004040D" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle VerticalAlignment="Bottom" Height="300" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0004040D" Offset="0" />
                        <GradientStop Color="#B304040D" Offset="0.45" />
                        <GradientStop Color="#F204040D" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid VerticalAlignment="Top" Margin="48,27,48,0">
                <StackPanel Margin="0,0,90,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" FontSize="24" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="ClockText" Style="{StaticResource TitleText}" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,27">
                <!-- Direct : programme en cours et suivant -->
                <Grid x:Name="LiveInfo" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="60" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="{StaticResource GlassStrongBrush}" />
                        <ui:RemoteImage x:Name="LiveLogo" ImageStretch="Uniform" ImagePadding="10,8,10,8" DecodeWidth="96" Glyph="&#xE7F4;" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource OnAirBrush}" CornerRadius="5" Padding="7,2">
                                <TextBlock Text="EN DIRECT" Style="{StaticResource EyebrowText}" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource WhiteBrush}" />
                            </Border>
                            <TextBlock x:Name="LiveNumber" Style="{StaticResource FaintText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LiveNow" Style="{StaticResource StrongText}" FontSize="17" Margin="0,6,0,0" />
                        <ProgressBar x:Name="LiveProgress" Style="{StaticResource ThinProgress}" Foreground="{StaticResource OnAirBrush}"
                                     Width="340" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock x:Name="LiveTimes" Style="{StaticResource FaintText}" Margin="0,6,0,0" />
                        <TextBlock x:Name="LiveNext" Style="{StaticResource CardSubText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Films et séries : barre de lecture -->
                <Grid x:Name="VodInfo" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    <Button x:Name="SeekBar" Grid.Column="1" Style="{StaticResource BareButton}" Height="30" Click="OnPlayPause"
                            GotFocus="OnSeekFocus" LostFocus="OnSeekFocus">
                        <Grid x:Name="SeekArea" Height="30">
                            <Border x:Name="SeekTrack" Height="5" CornerRadius="3" Background="#40FFFFFF" VerticalAlignment="Center" />
                            <Border x:Name="SeekFill" Height="5" CornerRadius="3" Background="{StaticResource AccentGradient}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                            <Ellipse x:Name="SeekKnob" Width="16" Height="16" Fill="{StaticResource WhiteBrush}" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                    </Button>
                    <TextBlock x:Name="RemainText" Grid.Column="2" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                               Margin="16,0,0,0" MinWidth="130" TextAlignment="Right" />
                </Grid>

                <StackPanel x:Name="Buttons" Orientation="Horizontal">
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="0,0,12,0" Click="OnPlayPause">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button x:Name="Back10Button" Style="{StaticResource PlayerButton}" Content="−10 s" Click="OnBack10" />
                    <Button x:Name="Forward30Button" Style="{StaticResource PlayerButton}" Content="+30 s" Click="OnForward30" />
                    <Button x:Name="ChannelsButton" Style="{StaticResource PlayerButton}" Click="OnChannels">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="14" />
                            <TextBlock Text="Chaînes" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TracksButton" Style="{StaticResource PlayerButton}" Click="OnTracks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE190;" Style="{StaticResource IconText}" FontSize="14" />
                            <TextBlock Text="Audio, sous-titres" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource PlayerButton}" Click="OnNextEpisode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE101;" Style="{StaticResource IconText}" FontSize="14" />
                            <TextBlock Text="Épisode suivant" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Width="40" Height="40" Click="OnFavorite">
                        <TextBlock x:Name="FavoriteGlyph" Text="&#xE734;" Style="{StaticResource IconText}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Retour visuel bref (avance, recul, format d'image) -->
        <Border x:Name="Flash" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,12" CornerRadius="16"
                Background="#CC04040D" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="FlashText" Style="{StaticResource TitleText}" FontSize="22" />
        </Border>

        <!-- Panneau latéral : chaînes, ou audio / sous-titres / image -->
        <Grid x:Name="SidePanel" Visibility="Collapsed">
            <Rectangle Width="480" HorizontalAlignment="Right" Fill="{StaticResource PanelShade}" />
            <Grid Width="356" HorizontalAlignment="Right" Margin="0,27,44,27">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PanelTitle" Style="{StaticResource TitleText}" FontSize="20" Margin="12,0,0,10" />
                <ListView x:Name="PanelChannels" Grid.Row="1" Style="{StaticResource ColumnListStyle}"
                          ItemContainerStyle="{StaticResource RowItemStyle}" ItemTemplate="{StaticResource ChannelRowTemplate}"
                          ItemClick="OnPanelChannel" ContainerContentChanging="OnPanelChannelRealized"
                          Padding="4,2,4,2" ui:TvScroll.Margins="0,40,0,40" Visibility="Collapsed" />
                <ScrollViewer x:Name="PanelOptions" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Disabled" IsTabStop="False">
                    <StackPanel>
                        <TextBlock Text="AUDIO" Style="{StaticResource PanelHeader}" Margin="12,0,0,6" />
                        <ListView x:Name="AudioList" Style="{StaticResource ColumnListStyle}" ItemContainerStyle="{StaticResource RowItemStyle}"
                                  ItemTemplate="{StaticResource OptionTemplate}" ItemClick="OnAudioClick" Padding="4,2,4,2"
                                  ScrollViewer.VerticalScrollMode="Disabled" />
                        <TextBlock Text="SOUS-TITRES" Style="{StaticResource PanelHeader}" />
                        <ListView x:Name="SubtitleList" Style="{StaticResource ColumnListStyle}" ItemContainerStyle="{StaticResource RowItemStyle}"
                                  ItemTemplate="{StaticResource OptionTemplate}" ItemClick="OnSubtitleClick" Padding="4,2,4,2"
                                  ScrollViewer.VerticalScrollMode="Disabled" />
                        <TextBlock Text="IMAGE" Style="{StaticResource PanelHeader}" />
                        <ListView x:Name="ImageList" Style="{StaticResource ColumnListStyle}" ItemContainerStyle="{StaticResource RowItemStyle}"
                                  ItemTemplate="{StaticResource OptionTemplate}" ItemClick="OnImageClick" Padding="4,2,4,2"
                                  ScrollViewer.VerticalScrollMode="Disabled" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,12,0,0">
                    <ui:Hint Key="A" Text="Choisir" />
                    <ui:Hint Key="B" Text="Fermer" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Épisode suivant -->
        <Border x:Name="UpNext" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,40"
                Width="390" CornerRadius="18" Background="#F2101030" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="20,18">
            <StackPanel>
                <TextBlock Text="ÉPISODE SUIVANT" Style="{StaticResource EyebrowText}" />
                <TextBlock x:Name="UpNextTitle" Style="{StaticResource StrongText}" FontSize="17" Margin="0,6,0,0" TextWrapping="WrapWholeWords" MaxLines="2" />
                <TextBlock x:Name="UpNextCountdown" Style="{StaticResource FaintText}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="UpNextPlay" Style="{StaticResource PrimaryButton}" Content="Lire maintenant" Click="OnUpNextPlay" />
                    <Button x:Name="UpNextCancel" Style="{StaticResource FluxButton}" Content="Annuler" Margin="12,0,0,0" Click="OnUpNextCancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Erreur de lecture -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
            <Border Width="72" Height="72" CornerRadius="36" Background="#2EFB7185" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="30" Foreground="{StaticResource ErrorBrush}" />
            </Border>
            <TextBlock x:Name="ErrorTitle" Style="{StaticResource TitleText}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="WrapWholeWords" Margin="0,16,0,0" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" Content="Réessayer" Click="OnRetry" />
                <Button x:Name="ErrorChannels" Style="{StaticResource FluxButton}" Content="Autre chaîne" Margin="12,0,0,0" Click="OnChannels" />
                <Button x:Name="CloseButton" Style="{StaticResource FluxButton}" Content="Fermer" Margin="12,0,0,0" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
