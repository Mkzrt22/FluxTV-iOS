<UserControl
    x:Class="FluxTV.Views.CatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluxTV.UI"
    IsTabStop="False">

    <Grid Margin="0,27,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- En-tête : titre, nombre, tri, aides -->
        <Grid Grid.ColumnSpan="3" Margin="0,0,48,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="CountText" Style="{StaticResource FaintText}" VerticalAlignment="Bottom" Margin="12,0,0,3" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Hint Key="Y" Text="{ui:T Fr='Favori', En='Favorite'}" />
                <Button x:Name="SortButton" Style="{StaticResource ChipButton}" Click="OnSort" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource AccentBrightBrush}" />
                        <TextBlock x:Name="SortText" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="Categories" Grid.Row="1" Style="{StaticResource ColumnListStyle}"
                  ItemContainerStyle="{StaticResource RowItemStyle}" ItemTemplate="{StaticResource CategoryTemplate}"
                  ItemClick="OnCategoryClick" GotFocus="OnCategoryFocus" Margin="-4,0,0,22" Padding="4,2,4,2"
                  ui:TvScroll.Margins="0,30,0,30" />

        <GridView x:Name="PosterGrid" Grid.Row="1" Grid.Column="2" Style="{StaticResource CatalogGridStyle}"
                  ItemContainerStyle="{StaticResource CardGridItemStyle}" ItemTemplate="{StaticResource PosterTemplate}"
                  ItemClick="OnCardClick" KeyDown="OnGridKeyDown" Padding="16,16,30,40" Margin="-16,-6,0,0"
                  ui:TvScroll.Margins="16,30,16,46" />

        <StackPanel x:Name="StatePanel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="400" Margin="0,0,48,60" Visibility="Collapsed">
            <ProgressRing x:Name="StateRing" Width="36" Height="36" Foreground="{StaticResource AccentBrightBrush}" />
            <TextBlock x:Name="StateTitle" Style="{StaticResource TitleText}" FontSize="18" TextAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="WrapWholeWords" Margin="0,14,0,0" />
            <TextBlock x:Name="StateText" Style="{StaticResource BodyText}" TextAlignment="Center" HorizontalAlignment="Center"
                       Margin="0,6,0,0" MaxLines="4" />
            <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Click="OnRetry" Visibility="Collapsed" Content="{ui:T Fr='Réessayer', En='Retry'}" />
        </StackPanel>
    </Grid>
</UserControl>
