<local:TvPage
    x:Class="FluxTV.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxTV.Views"
    xmlns:ui="using:FluxTV.UI"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="SettingText" TargetType="TextBlock" BasedOn="{StaticResource CardSubText}">
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" Margin="-20,0,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" IsVerticalRailEnabled="False" ZoomMode="Disabled" IsTabStop="False">
        <StackPanel Padding="20,27,48,40" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Réglages" Style="{StaticResource TitleText}" />

            <!-- Source -->
            <TextBlock Text="SOURCE" Style="{StaticResource EyebrowText}" Margin="0,22,0,0" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock x:Name="SourceGlyph" Text="&#xE774;" Style="{StaticResource IconText}" FontSize="18"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SourceTitle" Style="{StaticResource SettingTitle}" />
                            <TextBlock x:Name="SourceDetail" Style="{StaticResource SettingText}" />
                            <TextBlock x:Name="AccountDetail" Style="{StaticResource SettingText}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="RefreshButton" Style="{StaticResource FluxButton}" Click="OnRefresh" GotFocus="OnTopFocus">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" />
                                <TextBlock Text="Actualiser les listes" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EmbeddedButton" Style="{StaticResource FluxButton}" Margin="12,0,0,0" Click="OnUseEmbedded" Visibility="Collapsed" GotFocus="OnTopFocus">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" FontSize="14" />
                                <TextBlock Text="Mon compte" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChangeButton" Style="{StaticResource FluxButton}" Margin="12,0,0,0" Click="OnChangeSource" GotFocus="OnTopFocus">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" Style="{StaticResource IconText}" FontSize="14" />
                                <TextBlock Text="Changer de source" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ConfirmText" Style="{StaticResource SettingText}" Foreground="{StaticResource GoldBrush}" Visibility="Collapsed"
                               Margin="0,10,0,0" Text="Appuie encore sur « Changer de source » pour confirmer." />
                </StackPanel>
            </Border>

            <!-- Lecture -->
            <TextBlock Text="LECTURE" Style="{StaticResource EyebrowText}" Margin="0,24,0,0" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ToggleSwitch x:Name="AutoplaySwitch" Header="Enchaîner les épisodes" OnContent="Oui" OffContent="Non" Toggled="OnToggled" />
                    <TextBlock Style="{StaticResource SettingText}" Text="À la fin d'un épisode, le suivant démarre tout seul après un court compte à rebours." />
                    <ToggleSwitch x:Name="RefreshRateSwitch" Header="Adapter la fréquence de la télé" OnContent="Oui" OffContent="Non"
                                  Toggled="OnToggled" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource SettingText}" Text="La télé passe en 24, 50 ou 60 Hz selon la vidéo : images plus fluides, sans saccades. Active aussi « Autoriser 24 Hz » et « Autoriser 50 Hz » dans les réglages vidéo de la Xbox." />
                    <Grid Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Format du direct" Style="{StaticResource SettingTitle}" />
                            <TextBlock x:Name="FormatDetail" Style="{StaticResource SettingText}" />
                        </StackPanel>
                    </Grid>
                    <Button x:Name="FormatButton" Style="{StaticResource ChipButton}" Margin="0,10,0,0" Click="OnFormat">
                        <TextBlock x:Name="FormatText" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Contenus -->
            <TextBlock Text="CONTENUS" Style="{StaticResource EyebrowText}" Margin="0,24,0,0" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ToggleSwitch x:Name="AdultSwitch" Header="Masquer les contenus pour adultes" OnContent="Oui" OffContent="Non" Toggled="OnToggled" />
                    <TextBlock Style="{StaticResource SettingText}" Text="Les catégories pour adultes n'apparaissent ni dans les listes ni dans la recherche." />
                </StackPanel>
            </Border>

            <!-- Manette -->
            <TextBlock Text="MANETTE" Style="{StaticResource EyebrowText}" Margin="0,24,0,0" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pendant la lecture" Style="{StaticResource SettingTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Hint Key="A" Text="Commandes" />
                        <ui:Hint Key="B" Text="Retour" />
                        <ui:Hint Key="X" Text="Chaînes" />
                        <ui:Hint Key="Y" Text="Audio et sous-titres" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Hint Key="LB" Text="Chaîne précédente / −30 s" />
                        <ui:Hint Key="RB" Text="Chaîne suivante / +30 s" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingText}" Margin="0,10,0,0"
                               Text="Direct : ⬆ ⬇ pour zapper. Films et séries : ⬅ ➡ pour avancer ou reculer de 10 secondes." />
                </StackPanel>
            </Border>

            <!-- À propos -->
            <TextBlock Text="À PROPOS" Style="{StaticResource EyebrowText}" Margin="0,24,0,0" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="ms-appx:///Assets/BrandMark.png" Width="40" Height="40" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Style="{StaticResource SettingTitle}" />
                            <TextBlock Style="{StaticResource SettingText}" Text="Tes identifiants restent chiffrés sur cette console." />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingText}" Margin="0,12,0,0"
                               Text="FluxTV Player est un lecteur : il ne fournit aucune chaîne ni aucun contenu. Il lit uniquement les sources que tu ajoutes." />
                    <Button x:Name="CreditsButton" Style="{StaticResource ChipButton}" Margin="0,12,0,0" Click="OnCredits" GotFocus="OnBottomFocus">
                        <TextBlock x:Name="CreditsLabel" Text="Crédits et licences" />
                    </Button>
                    <StackPanel x:Name="Credits" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SettingText}"
                                   Text="Films de démonstration : Big Buck Bunny (2008) et Tears of Steel (2012), © Blender Foundation, blender.org, sous licence Creative Commons Attribution 3.0." />
                        <TextBlock Style="{StaticResource SettingText}"
                                   Text="Mire en direct : flux de démonstration public d'Unified Streaming. Flux de test hébergés par Mux et Unified Streaming." />
                        <TextBlock Style="{StaticResource SettingText}"
                                   Text="Polices Sora et Manrope : SIL Open Font License 1.1. Animation de lancement dessinée avec Win2D (licence MIT)." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:TvPage>
