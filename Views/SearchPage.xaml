<local:TvPage
    x:Class="FluxTV.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxTV.Views"
    xmlns:ui="using:FluxTV.UI"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" Margin="-20,0,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" IsVerticalRailEnabled="False" ZoomMode="Disabled" IsTabStop="False">
        <StackPanel Padding="20,27,0,40">
            <TextBlock Text="{ui:T Fr='Rechercher', En='Search'}" Style="{StaticResource TitleText}" />
            <Grid Margin="0,14,48,0" HorizontalAlignment="Left" Width="540">
                <TextBox x:Name="Query" Style="{StaticResource FieldBox}" PlaceholderText="{ui:T Fr='Chaîne, film, série…', En='Channel, movie, series…'}" InputScope="Search"
                         TextChanged="OnQueryChanged" KeyDown="OnQueryKeyDown" GotFocus="OnQueryFocus" Padding="40,9,8,0" />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="15" Foreground="{StaticResource TextFaintBrush}"
                           HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <StackPanel x:Name="StatePanel" Orientation="Horizontal" Margin="0,18,0,0">
                <ProgressRing x:Name="StateRing" Width="20" Height="20" Foreground="{StaticResource AccentBrightBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="StateText" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           Text="{ui:T Fr='Appuie sur Ⓐ pour écrire avec le clavier de la console.', En='Press Ⓐ to type with the console keyboard.'}" />
            </StackPanel>

            <ui:CardRow x:Name="ChannelsRow" Title="{ui:T Fr='Chaînes', En='Channels'}" CardTemplate="{StaticResource WideTemplate}" ShowCount="True" />
            <ui:CardRow x:Name="MoviesRow" Title="{ui:T Fr='Films', En='Movies'}" CardTemplate="{StaticResource PosterTemplate}" ShowCount="True" />
            <ui:CardRow x:Name="SeriesRow" Title="{ui:T Fr='Séries', En='Series'}" CardTemplate="{StaticResource PosterTemplate}" ShowCount="True" />
        </StackPanel>
    </ScrollViewer>
</local:TvPage>
