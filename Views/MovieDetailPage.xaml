<local:TvPage
    x:Class="FluxTV.Views.MovieDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxTV.Views"
    xmlns:ui="using:FluxTV.UI"
    Background="Transparent">

    <Grid>
        <!-- Image du film en fond, sous le menu aussi -->
        <Grid Margin="-112,0,0,0" IsHitTestVisible="False">
            <ui:RemoteImage x:Name="Backdrop" DecodeWidth="960" Glyph="" Opacity="0.9" />
            <Rectangle Fill="{StaticResource ShadeLeft}" />
            <Rectangle Fill="{StaticResource ShadeBottomStrong}" VerticalAlignment="Bottom" Height="240" />
            <Rectangle Fill="{StaticResource ShadeTop}" VerticalAlignment="Top" Height="110" />
        </Grid>

        <Grid Margin="0,27,48,27">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500" Margin="0,0,28,0">
                <TextBlock x:Name="Eyebrow" Text="FILM" Style="{StaticResource EyebrowText}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" Margin="0,8,0,0" />
                <TextBlock x:Name="MetaText" Style="{StaticResource DimText}" Margin="0,8,0,0" TextWrapping="WrapWholeWords" MaxLines="2" />
                <StackPanel x:Name="BadgePanel" Orientation="Horizontal" Margin="0,10,0,0" />
                <TextBlock x:Name="PlotText" Style="{StaticResource BodyText}" MaxLines="5" Margin="0,14,0,0" />
                <TextBlock x:Name="CreditsText" Style="{StaticResource FaintText}" TextWrapping="WrapWholeWords" MaxLines="3"
                           LineHeight="17" Margin="0,10,0,0" />
                <ProgressRing x:Name="InfoRing" Width="22" Height="22" HorizontalAlignment="Left" Margin="0,12,0,0"
                              Foreground="{StaticResource AccentBrightBrush}" />

                <StackPanel x:Name="ResumePanel" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="ResumeBar" Style="{StaticResource ThinProgress}" Width="200" VerticalAlignment="Center" />
                    <TextBlock x:Name="ResumeText" Style="{StaticResource FaintText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Click="OnPlay">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource WhiteBrush}" />
                            <TextBlock x:Name="PlayText" Text="Lecture" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestartButton" Style="{StaticResource FluxButton}" Margin="14,0,0,0" Click="OnRestart" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" />
                            <TextBlock Text="Depuis le début" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Margin="14,0,0,0" Click="OnFavorite">
                        <TextBlock x:Name="FavoriteGlyph" Text="&#xE734;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button x:Name="WatchedButton" Style="{StaticResource IconButton}" Margin="12,0,0,0" Click="OnWatched">
                        <TextBlock x:Name="WatchedGlyph" Text="&#xE73E;" Style="{StaticResource IconText}" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ActionHint" Style="{StaticResource FaintText}" Margin="2,10,0,0" />
            </StackPanel>

            <Grid Grid.Column="1" Width="176" Height="264" VerticalAlignment="Center">
                <Border CornerRadius="14" Background="{StaticResource Surface2Brush}" />
                <ui:RemoteImage x:Name="Poster" Radius="14" DecodeWidth="176" Glyph="&#xE8B2;" />
                <Border CornerRadius="14" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" />
            </Grid>
        </Grid>
    </Grid>
</local:TvPage>
