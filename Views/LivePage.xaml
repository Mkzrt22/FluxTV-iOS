<local:TvPage
    x:Class="FluxTV.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluxTV.Views"
    xmlns:ui="using:FluxTV.UI"
    Background="Transparent">

    <Grid Margin="0,27,48,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="TV en direct" Style="{StaticResource TitleText}" />
            <TextBlock x:Name="CountText" Style="{StaticResource FaintText}" VerticalAlignment="Bottom" Margin="12,0,0,3" />
        </StackPanel>

        <!-- Catégories -->
        <ListView x:Name="Categories" Grid.Row="1" Style="{StaticResource ColumnListStyle}"
                  ItemContainerStyle="{StaticResource RowItemStyle}" ItemTemplate="{StaticResource CategoryTemplate}"
                  ItemClick="OnCategoryClick" GotFocus="OnCategoryFocus" Margin="-4,0,0,0" Padding="4,2,4,2"
                  ui:TvScroll.Margins="0,30,0,30" />

        <!-- Chaînes -->
        <ListView x:Name="Channels" Grid.Row="1" Grid.Column="2" Style="{StaticResource ColumnListStyle}"
                  ItemContainerStyle="{StaticResource RowItemStyle}" ItemTemplate="{StaticResource ChannelRowTemplate}"
                  ItemClick="OnChannelClick" GotFocus="OnChannelFocus" KeyDown="OnChannelKeyDown"
                  ContainerContentChanging="OnChannelRealized" Padding="4,2,4,2" ui:TvScroll.Margins="0,40,0,40" />

        <StackPanel x:Name="StatePanel" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
            <ProgressRing x:Name="StateRing" Width="36" Height="36" Foreground="{StaticResource AccentBrightBrush}" />
            <TextBlock x:Name="StateTitle" Style="{StaticResource TitleText}" FontSize="18" TextAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="WrapWholeWords" Margin="0,14,0,0" />
            <TextBlock x:Name="StateText" Style="{StaticResource BodyText}" TextAlignment="Center" HorizontalAlignment="Center"
                       Margin="0,6,0,0" MaxLines="4" />
            <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Click="OnRetry" Visibility="Collapsed" Content="Réessayer" />
        </StackPanel>

        <!-- Chaîne sous le focus : programme en cours et suivant -->
        <StackPanel x:Name="Details" Grid.Row="1" Grid.Column="4" Visibility="Collapsed">
            <Grid Height="128">
                <Border CornerRadius="14" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" />
                <ui:RemoteImage x:Name="DetailLogo" ImageStretch="Uniform" ImagePadding="34,24,34,24" DecodeWidth="230" Glyph="&#xE7F4;" />
            </Grid>
            <TextBlock x:Name="DetailName" Style="{StaticResource TitleText}" FontSize="18" Margin="0,12,0,0" />
            <TextBlock x:Name="DetailCategory" Style="{StaticResource FaintText}" Margin="0,2,0,0" />
            <StackPanel x:Name="NowPanel" Margin="0,16,0,0">
                <TextBlock Text="EN CE MOMENT" Style="{StaticResource EyebrowText}" Foreground="{StaticResource OnAirBrush}" />
                <TextBlock x:Name="NowTitle" Style="{StaticResource StrongText}" TextWrapping="WrapWholeWords" MaxLines="2" Margin="0,5,0,0" />
                <TextBlock x:Name="NowTime" Style="{StaticResource FaintText}" Margin="0,3,0,0" />
                <ProgressBar x:Name="NowProgress" Style="{StaticResource ThinProgress}" Foreground="{StaticResource OnAirBrush}" Margin="0,8,0,0" />
                <TextBlock x:Name="NowDesc" Style="{StaticResource BodyText}" FontSize="13" LineHeight="19" MaxLines="5" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="NextPanel" Margin="0,14,0,0">
                <TextBlock Text="À SUIVRE" Style="{StaticResource EyebrowText}" />
                <TextBlock x:Name="NextTitle" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                <TextBlock x:Name="NextTime" Style="{StaticResource FaintText}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Hint Key="A" Text="Regarder" />
            <ui:Hint Key="Y" Text="Favori" />
            <ui:Hint Key="B" Text="Menu" />
        </StackPanel>
    </Grid>
</local:TvPage>
